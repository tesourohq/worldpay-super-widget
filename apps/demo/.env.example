# Copy to `apps/demo/.env.local` and fill in real values. Never commit those.
#
# Every variable here is read on the server only. None may be given a
# `NEXT_PUBLIC_` prefix: two are secrets, and `TESOURO_ORGANIZATION_REFERENCE`
# drives widget visibility, so the browser must not get a say in it.

# Partner credentials for the widget token exchange. From the Tesouro
# onboarding for your client, per environment.
TESOURO_CLIENT_ID=
TESOURO_CLIENT_SECRET=

# Shared secret the widget JWE is encrypted with (A256KW + A256GCM).
TESOURO_WIDGET_SECRET=

# Stable, opaque identifier for the business the widget user belongs to. Minted
# into the token so the gateway can read application status keyed on it.
TESOURO_ORGANIZATION_REFERENCE=

# The demo has no login, so it mints for a fixed identity. A real host resolves
# these from its own signed session instead.
DEMO_USER_ID=
DEMO_USER_EMAIL=

# Which Tesouro API the widget talks to. Optional; defaults to the sandbox
# below. Must be one of: https://api.tesouro.com, https://api.sandbox.tesouro.com,
# https://api.business-banking.app, https://api.stage.tesouro.com,
# https://api.sandbox.stage.tesouro.com, https://api.stage.business-banking.app
TESOURO_API_BASE_URL=https://api.sandbox.stage.tesouro.com
